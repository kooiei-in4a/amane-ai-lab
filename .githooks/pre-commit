#!/bin/sh
# Block commits that introduce likely secrets / sensitive data.
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1
echo "pre-commit: running sensitive-data scan on staged files"
if command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/check_sensitive_data.py --staged
fi
if command -v python >/dev/null 2>&1; then
  exec python scripts/check_sensitive_data.py --staged
fi
echo "pre-commit: python3/python not found" >&2
exit 1
